---
/**
 * Multiple-choice question for the "Check" part, rendered as the interactive QuizQuestion island
 * (docs/M2.md §5). The explanation (slot) is rendered on the server and passed to the island.
 * Without JavaScript the island's server output is still a readable question with a <details> answer.
 */
import '../../styles/quiz.css';
import { loadMessages, pickPrefix, toLocale } from '../../i18n/loadMessages';
import QuizQuestion from '../../islands/QuizQuestion.tsx';
import { lessonKeyFromPath } from '../../progress/index.ts';

interface Props {
  number: number;
  question: string;
  options: string[];
  /** Zero-based index of the correct option. */
  answer: number;
}

const { number, question, options, answer } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const messages = pickPrefix(loadMessages(locale, ['quiz']), 'quiz.question.');
const lessonKey = lessonKeyFromPath(Astro.url.pathname, import.meta.env.BASE_URL);
---

<div class="cv-check-host not-content">
  <QuizQuestion client:visible lessonKey={lessonKey} number={number} question={question} options={options} answer={answer} messages={messages} locale={locale}>
    <slot />
  </QuizQuestion>
</div>
