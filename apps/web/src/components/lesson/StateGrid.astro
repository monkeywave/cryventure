---
/**
 * A byte grid such as the AES state. `cells` is given in fill `order` (default column-major,
 * cells[r + 4c] = s[r,c], exactly like FIPS 197 §3.4 maps in[r + 4c] onto the 4×4 state).
 */
import type { GridShape } from '@cryventure/viz';
import { namespaceTranslator } from './namespaceTranslator';
import { DEFAULT_LESSON_KIND, type LessonKind } from './lessonKinds';
import { AES_STATE_ORDER, AES_STATE_SHAPE, range, stateGridRows, type GridOrder } from './stateGridLayout';

interface Props {
  cells: string[];
  caption: string;
  kind?: LessonKind;
  /** [rows, cols]; defaults to the 4×4 AES state. */
  shape?: GridShape;
  /** How `cells` fill the grid; defaults to column-major. */
  order?: GridOrder;
}

const { cells, caption, kind = DEFAULT_LESSON_KIND, shape = AES_STATE_SHAPE, order = AES_STATE_ORDER } = Astro.props;
const rows = stateGridRows(cells, shape, order);
const columnIndices = range(shape[1]);
const t = namespaceTranslator(Astro.currentLocale, 'lesson');
---

<figure class="cv-state-grid not-content" data-kind={kind}>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <td></td>
        {columnIndices.map((column) => <th scope="col" aria-label={t('lesson.stateGrid.column', { column })}>c={column}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((rowCells, row) => (
          <tr>
            <th scope="row" aria-label={t('lesson.stateGrid.row', { row })}>r={row}</th>
            {rowCells.map((cell) => <td>{cell}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>

<style>
  .cv-state-grid {
    --cv-grid-accent: var(--cv-state);
    margin-block: 1.25rem;
    overflow-x: auto;
  }

  .cv-state-grid[data-kind='plaintext'] {
    --cv-grid-accent: var(--cv-plaintext);
  }

  .cv-state-grid[data-kind='ciphertext'] {
    --cv-grid-accent: var(--cv-ciphertext);
  }

  .cv-state-grid[data-kind='key'] {
    --cv-grid-accent: var(--cv-key);
  }

  .cv-state-grid[data-kind='subkey'] {
    --cv-grid-accent: var(--cv-subkey);
  }

  .cv-state-grid[data-kind='nonce'] {
    --cv-grid-accent: var(--cv-nonce);
  }

  .cv-state-grid[data-kind='constant'] {
    --cv-grid-accent: var(--cv-constant);
  }

  .cv-state-grid[data-kind='tag'] {
    --cv-grid-accent: var(--cv-success);
  }

  .cv-state-grid table {
    border-collapse: separate;
    border-spacing: 0.25rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }

  .cv-state-grid caption {
    caption-side: bottom;
    padding-block-start: 0.375rem;
    color: var(--cv-text-muted);
    font-family: var(--sl-font-system);
    font-size: var(--sl-text-xs);
    text-align: start;
  }

  .cv-state-grid th {
    color: var(--cv-text-muted);
    font-weight: 400;
  }

  .cv-state-grid td:not(:empty) {
    min-width: 3.25rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--cv-grid-accent);
    border-radius: 0.375rem;
    background: var(--cv-surface);
    color: var(--cv-text);
    text-align: center;
  }
</style>
