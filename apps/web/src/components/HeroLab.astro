---
/**
 * The home page's hero lab (docs/M4.md §8): the generic AES lab in story mode with the
 * "Type your own text" field (`<Lab textInput />`), the FIPS 197 C.1 key, and links onward. Only the
 * layout's views (state + narration) and no generic inputs panel: the text field is the only input.
 * Never autoplays. Usage: `<HeroLab />` in `{en,de}/index.mdx`.
 */
import { createTranslator } from '@cryventure/core';
import { loadMessages, pickPrefix, toLocale } from '../i18n/loadMessages';
import { withBase } from '../lib/withBase';
import Lab from './Lab.astro';

const locale = toLocale(Astro.currentLocale);
const t = createTranslator(pickPrefix(loadMessages(locale, ['hero']), 'ui.hero.'), { locale });
const links = [
  { href: withBase(`${locale}/foundations/prologue/`), label: t('ui.hero.startAdventure'), primary: true },
  { href: withBase(`${locale}/symmetric/aes/`), label: t('ui.hero.aesLesson'), primary: false },
];
---

<section class="cv-hero-lab not-content" aria-labelledby="cv-hero-lab-heading">
  <h2 id="cv-hero-lab-heading" class="cv-hero-lab__heading">{t('ui.hero.heading')}</h2>
  <p class="cv-hero-lab__intro">{t('ui.hero.intro')}</p>
  <Lab labId="hero" producerId="aes" presetId="fips197-c1" layout="state:65|narration:35" mode="story" views="layout-only" paramPanel={false} textInput />
  <nav class="cv-hero-lab__links">
    {
      links.map((link) => (
        <a class:list={['cv-hero-lab__link', { 'cv-hero-lab__link--primary': link.primary }]} href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
</section>

<style>
  .cv-hero-lab {
    margin-block: 1rem 2.5rem;
  }

  /* The splash page has no sidebar, so the lab stays in the (already wide) content column, aligned with the heading. */
  .cv-hero-lab :global(.cv-breakout) {
    width: 100%;
    left: 0;
    transform: none;
  }

  .cv-hero-lab__heading {
    margin: 0 0 0.25rem;
    font-size: var(--sl-text-2xl, 1.5rem);
    color: var(--cv-text);
  }

  .cv-hero-lab__intro {
    margin: 0 0 0.75rem;
    color: var(--cv-text-muted);
  }

  .cv-hero-lab__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1rem;
  }

  .cv-hero-lab__link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    color: var(--cv-text);
    text-decoration: none;
    font-weight: 600;
  }

  .cv-hero-lab__link--primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .cv-hero-lab__link:hover {
    border-color: var(--sl-color-accent-high);
  }

  .cv-hero-lab__link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
