---
/**
 * Server wrapper for the generic <Lab> island (docs/PLAN.md §2b, §5):
 * - passes only this lab's messages for the current locale,
 * - renders a static, translated poster that stays visible until the island is ready,
 * - hydrates when scrolled into view.
 */
import '@cryventure/viz/viz.css';
import '../styles/lab.css';
import { createTranslator, paramFieldsOf, type Lens, type Messages } from '@cryventure/core';
import LabIsland from '../islands/Lab.tsx';
import { labMessages } from '../labs/labMessages';
import { choiceLabelKey } from '../labs/paramFields';
import { producerRegistry, resolveLab } from '../labs/registry';
import { presetParams } from '../labs/startParams';
import { isLabMode, parseStartAt } from '../labs/startAt';
import Breakout from './Breakout.astro';
import EducationalOnly from './EducationalOnly.astro';

interface Props {
  labId: string;
  producerId: string;
  presetId?: string;
  layout?: string;
  lens?: Lens;
  /** Start position when the deep link has none: `"round:1,op:subBytes"` (first matching step) or `"step:12"` (as displayed). */
  startAt?: string;
  /** Preselected player mode: `"story"` or `"debugger"` (default). Playback still needs a user action. */
  mode?: string;
  /** This lab's message table, when the page has already built it (`labMessages(lang, producer)`). */
  messages?: Messages;
}

const { labId, producerId, presetId, layout, lens, startAt, mode, messages: givenMessages } = Astro.props;
const lang = Astro.currentLocale ?? 'en';
const resolved = resolveLab(producerId);
if (!resolved.ok) throw new Error(`<Lab labId="${labId}">: unknown producer "${producerId}"`);
const { producer } = resolved.lab;
const messages = givenMessages ?? labMessages(lang, producer);
const t = createTranslator(messages, { locale: lang });
const preset = producer.presets.find((entry) => entry.id === presetId);
if (presetId !== undefined && preset === undefined) throw new Error(`<Lab labId="${labId}">: unknown preset "${presetId}"`);
if (startAt !== undefined && parseStartAt(startAt) === undefined) throw new Error(`<Lab labId="${labId}">: invalid startAt "${startAt}"`);
if (mode !== undefined && !isLabMode(mode)) throw new Error(`<Lab labId="${labId}">: unknown mode "${mode}"`);
const startParams = presetParams(producer, presetId) as Record<string, unknown>;
const posterFields = paramFieldsOf(producer);
const registered = producerRegistry.list();
/** A choice (`select` / `port`) shows its translated label; anything else its raw value. */
const posterChoice = (field: (typeof posterFields)[number]) => choiceLabelKey(field, startParams[field.name], registered);
---

<Breakout>
  <div class="cv-lab-host" data-pagefind-ignore>
    <EducationalOnly lang={lang} />
    <LabIsland client:visible labId={labId} producerId={producerId} presetId={presetId} layout={layout} lens={lens} startAt={startAt} mode={isLabMode(mode) ? mode : undefined} messages={messages} locale={lang}>
      <div class="cv-lab-poster" aria-busy="true">
        <p class="cv-lab__title">{t(producer.titleKey)}</p>
        {preset && <p>{t('ui.lab.posterPreset', { preset: t(preset.labelKey) })}</p>}
        <dl class="cv-lab-poster__params">
          {
            posterFields.map((field) => (
              <div>
                <dt>{t(field.labelKey)}</dt>
                <dd>{field.kind === 'select' || field.kind === 'port' ? t(posterChoice(field) ?? String(startParams[field.name])) : <code>{String(startParams[field.name])}</code>}</dd>
              </div>
            ))
          }
        </dl>
        <p class="cv-lab-poster__loading" role="status">{t('ui.lab.loading')}</p>
      </div>
    </LabIsland>
  </div>
</Breakout>

<script>
  // Bundled once per page: `#<heading>&lab=…` links scroll to the heading like a plain `#<heading>`.
  import { scrollToHeadingAnchor } from '../labs/anchorScroll';
  scrollToHeadingAnchor();
</script>
