---
/**
 * Starlight's ThemeSelect plus the page-wide lens selector (docs/M2.md §6). Starlight renders this
 * twice per page (desktop header, mobile menu footer); one bundled script serves both instances.
 * The stored lens reaches `<html data-lens>` before paint through the early script in `Head.astro`.
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import Select from '@astrojs/starlight/components/Select.astro';
import { namespaceTranslator } from '../components/lesson/namespaceTranslator';
import { DEFAULT_LENS, LENS_ORDER } from '../progress/lens';

const t = namespaceTranslator(Astro.currentLocale, 'lens');
const options = LENS_ORDER.map((lens) => ({ label: t(`lens.name.${lens}`), value: lens, selected: lens === DEFAULT_LENS }));
---

<Default />
<cv-lens-select>
  {/* `auto` sizes the select to its longest option in every language (Starlight's Select reads the custom property). */}
  <Select icon="open-book" label={t('lens.select.label')} options={options} width="auto" />
</cv-lens-select>

<script>
  // Specific modules, not '../progress': its index also exports the React hooks.
  import { applyLensToDocument, DEFAULT_LENS, isLens } from '../progress/lens';
  import { getProgress, setLens, subscribe } from '../progress/store';

  const LENS_SELECTS = 'cv-lens-select select';

  /** Reflects the stored lens on `<html>` and on every lens selector; follows other tabs, too. */
  function syncLens(): void {
    const lens = getProgress().lens ?? DEFAULT_LENS;
    applyLensToDocument(lens);
    document.querySelectorAll<HTMLSelectElement>(LENS_SELECTS).forEach((select) => (select.value = lens));
  }

  // Module scripts run once per page, after both selector instances are parsed.
  document.addEventListener('change', (event) => {
    const select = event.target;
    if (select instanceof HTMLSelectElement && select.matches(LENS_SELECTS) && isLens(select.value)) setLens(select.value);
  });
  subscribe(syncLens);
  syncLens();
</script>

<style>
  cv-lens-select {
    display: contents;
  }

  /*
   * Starlight sizes its theme select at a fixed 6.25em (see its "width that works well for each
   * language" TODO), which truncates German "System". Its label sets the width inline, so the custom
   * property is redefined on the select itself, the element that consumes it; `auto` fits the content.
   */
  :global(starlight-theme-select select) {
    --sl-select-width: auto;
  }
</style>
