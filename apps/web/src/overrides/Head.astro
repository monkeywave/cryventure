---
/**
 * Starlight's Head plus the early lens script (docs/M2.md §6): rendered once per page, before the
 * body, so `<html data-lens>` is set before any lens content is painted. The header lens selector's
 * bundled script keeps it in sync afterwards (see `ThemeSelect.astro`).
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { DEFAULT_LENS, LENS_ORDER } from '../progress/lens';
import { LEGACY_PROGRESS_STORAGE_KEY, PROGRESS_STORAGE_KEY } from '../progress/storage';
import PwaRegistration from '../components/PwaRegistration.astro';
import { isPwaEnabled } from '../../scripts/pwa.mjs';

/** Service worker and manifest: production builds only, off with `CV_PWA=false` (docs/M3.md §11). */
const pwaEnabled = import.meta.env.PROD && isPwaEnabled(process.env);
---

<Default />
{pwaEnabled && <PwaRegistration />}

{/*
  Inlined (CSP allows it) so the stored lens applies before first paint. Values travel as data-*
  attributes rather than define:vars, which would wrap the script and confuse type checking. Until the
  progress store has migrated the v1 slot (first page load after the upgrade), the lens is read from it.
*/}
<script is:inline data-storage-key={PROGRESS_STORAGE_KEY} data-legacy-storage-key={LEGACY_PROGRESS_STORAGE_KEY} data-lenses={LENS_ORDER.join(' ')} data-fallback={DEFAULT_LENS}>
  {
    const { storageKey, legacyStorageKey, lenses, fallback } = document.currentScript.dataset;
    let lens = fallback;
    try {
      const stored = JSON.parse(localStorage.getItem(storageKey) ?? localStorage.getItem(legacyStorageKey) ?? 'null')?.lens;
      if (lenses.split(' ').includes(stored)) lens = stored;
    } catch {
      // Unreadable storage: keep the default lens.
    }
    document.documentElement.dataset.lens = lens;
  }
</script>
