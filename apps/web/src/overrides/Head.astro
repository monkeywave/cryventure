---
/**
 * Starlight's Head plus the early lens script (docs/M2.md §6): rendered once per page, before the
 * body, so `<html data-lens>` is set before any lens content is painted. The header lens selector's
 * bundled script keeps it in sync afterwards (see `ThemeSelect.astro`).
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { DEFAULT_LENS, LENS_ORDER } from '../progress/lens';
import { LENS_STORAGE_KEY } from '../progress/storage';
import PwaRegistration from '../components/PwaRegistration.astro';
import { isPwaEnabled } from '../../scripts/pwa.mjs';

/** Service worker and manifest: production builds only, off with `CV_PWA=false` (docs/M3.md §11). */
const pwaEnabled = import.meta.env.PROD && isPwaEnabled(process.env);
---

<Default />
{pwaEnabled && <PwaRegistration />}

{/*
  Inlined (allowed by its hash: scripts/csp-postbuild.ts, docs/DEPLOY.md) so the stored lens applies before first paint. Values travel as data-*
  attributes rather than define:vars, which would wrap the script and confuse type checking. It reads
  only the schema-independent lens key, which the progress store keeps in sync (and seeds from v1/v2).
*/}
<script is:inline data-storage-key={LENS_STORAGE_KEY} data-lenses={LENS_ORDER.join(' ')} data-fallback={DEFAULT_LENS}>
  {
    const { storageKey, lenses, fallback } = document.currentScript.dataset;
    let lens = fallback;
    try {
      const stored = localStorage.getItem(storageKey);
      if (lenses.split(' ').includes(stored)) lens = stored;
    } catch {
      // Unreadable storage: keep the default lens.
    }
    document.documentElement.dataset.lens = lens;
  }
</script>
