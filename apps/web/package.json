{
  "name": "@cryventure/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CryVenture website: Astro + Starlight shell with interactive cryptography labs.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/csp-postbuild.ts && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "e2e": "playwright test",
    "e2e:subpath": "CV_BASE=/cryventure/ playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/starlight": "^0.42.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@cryventure/core": "workspace:*",
    "@cryventure/derivers": "workspace:*",
    "@cryventure/primitives": "workspace:*",
    "@cryventure/views": "workspace:*",
    "@cryventure/viz": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "workbox-build": "^7.4.1"
  }
