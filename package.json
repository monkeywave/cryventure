{
  "name": "cryventure",
  "private": true,
  "description": "CryVenture — Explore cryptography. Build understanding.",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cryventure/web dev",
    "build": "pnpm --filter @cryventure/web build",
    "preview": "pnpm --filter @cryventure/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "i18n:check": "tsx packages/tools/src/i18n/check-parity.ts",
    "i18n:stamp": "tsx packages/tools/src/i18n/stamp-source-hash.ts",
    "licenses:check": "tsx packages/tools/src/licenses/check.ts",
    "cv": "tsx packages/tools/src/scaffold/cli.ts",
    "layouts:generate": "tsx packages/tools/src/layouts/generate.ts",
    "asm:generate": "tsx packages/tools/src/asm/generate.ts",
    "golden:update": "CV_GOLDEN_UPDATE=1 vitest run packages/tools/src/contracts/all.contract.test.ts -t deriver",
    "fixtures:update": "CV_FIXTURES_UPDATE=1 vitest run packages/tools/src/contracts/snapshotFixtures.test.ts && pnpm golden:update",
    "e2e": "pnpm --filter @cryventure/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher"
    ]
  }
}
