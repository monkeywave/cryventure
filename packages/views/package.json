{
  "name": "@cryventure/views",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CryVenture view plugins (state, narration, ...). Each folder exports one manifest.ts.",
  "exports": {
    ".": "./src/index.ts",
    "./messages": "./src/messages.ts",
    "./*": "./src/*/manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cryventure/core": "workspace:*",
    "@cryventure/viz": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
